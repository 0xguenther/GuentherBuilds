{
  "name": "gunther-core",
  "version": "0.1.0",
  "description": "Günther: Autonomous AI Entrepreneur",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start:agent": "tsx src/index.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "stripe:init": "tsx scripts/init-stripe-product.ts",
    "reddit:status": "tsx scripts/reddit-manager.ts --status",
    "reddit:preview": "tsx scripts/reddit-manager.ts --preview",
    "reddit:publish": "tsx scripts/reddit-manager.ts --publish",
    "test": "vitest run",
    "test:all": "tsx test/simulate-e2e.ts && tsx test/clawmart-e2e.ts && tsx test/b2b-e2e.ts && tsx test/metrics-e2e.ts && tsx test/web3-e2e.ts && tsx test/reddit-e2e.ts",
    "test:watch": "vitest"
  },
  "keywords": [
    "ai-agent",
    "autonomous",
    "mcp",
    "stripe",
    "base",
    "cdp"
  ],
  "author": "Günther & Partner",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^10.1.5",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-raw-body": "^5.0.0",
    "gray-matter": "^4.0.3",
    "langfuse": "^3.35.0",
    "marked": "^18.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "stripe": "^17.7.0",
    "viem": "^2.23.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@vitest/ui": "^5.0.3",
    "happy-dom": "^20.14.5",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
