// Günther Core — State Management (SQLite via Prisma)
// Single source of truth for Events, Payments & Mentions (Idempotenz).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Payments & Token Burns ---

model Payment {
  id           String   @id @default(uuid())
  stripePaymentId String @unique
  stripeSessionId String?
  amountCents  Int
  currency     String   @default("USD")
  status       String   @default("received") // received | calculating | burning | burned | failed
  burnAmount   BigInt?
  txHash       String?  @unique
  downloadToken String? @unique
  downloadExpiresAt DateTime?
  downloadCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --- X (Twitter) Mentions ---

model Mention {
  id        String   @id @default(uuid())
  tweetId   String   @unique
  author    String
  text      String
  status    String   @default("seen") // seen | replying | replied | failed
  replyId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- LLM / Observability Tracing Log ---

model Trace {
  id         String   @id @default(uuid())
  taskId     String
  model      String
  task       String
  costUsd    Float    @default(0)
  tokens     Int      @default(0)
  status     String   @default("ok") // ok | error
  createdAt  DateTime @default(now())
}

// --- Claw Mart: AI Skills & MCP Marketplace ---

model Creator {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  xHandle            String?
  stripeCustomerId   String?  @unique
  subscriptionStatus String   @default("inactive") // inactive | active | past_due | canceled
  skills             Skill[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Skill {
  id              String          @id @default(uuid())
  title           String
  slug            String          @unique
  description     String
  category        String          // mcp | eliza_plugin | workflow
  priceCents      Int
  takeRatePercent Int             @default(10) // 10% platform take-rate, 100% if official
  isOfficial      Boolean         @default(false)
  creatorId       String?
  creator         Creator?        @relation(fields: [creatorId], references: [id])
  assetPath       String          // e.g. "skills/eliza-token-burner.zip"
  version         String          @default("1.0.0")
  downloadsCount  Int             @default(0)
  purchases       SkillPurchase[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model SkillPurchase {
  id                 String   @id @default(uuid())
  skillId            String
  skill              Skill    @relation(fields: [skillId], references: [id])
  buyerEmail         String?
  stripePaymentId    String   @unique
  amountCents        Int
  burnAmountCents    Int
  creatorPayoutCents Int
  downloadToken      String   @unique
  downloadExpiresAt  DateTime
  downloadCount      Int      @default(0)
  status             String   @default("completed") // completed | burned
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// --- Clawcommerce: B2B Enterprise Agent Setups ($2,000 Setup + $500/Mo Retainer) ---

model B2bLead {
  id                 String       @id @default(uuid())
  companyName        String
  contactName        String
  contactEmail       String
  useCase            String       // e.g. "Customer Support Autopilot", "Shopify Sales ReAct Agent"
  monthlyVolume      String       // e.g. "<1,000", "1,000 - 10,000", ">10,000"
  integrations       String       // Comma-separated or JSON list of integrations
  status             String       @default("submitted") // submitted | qualified | proposal_sent | contracted | active | archived
  proposalMarkdown   String?
  stripeCustomerId   String?      @unique
  stripeCheckoutId   String?      @unique
  contract           B2bContract?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model B2bContract {
  id                   String    @id @default(uuid())
  leadId               String    @unique
  lead                 B2bLead   @relation(fields: [leadId], references: [id])
  setupFeeCents        Int       @default(200000) // $2,000 USD
  retainerMonthlyCents Int       @default(50000)  // $500 USD / month
  setupPaid            Boolean   @default(false)
  setupTxHash          String?
  subscriptionId       String?   @unique
  subscriptionStatus   String    @default("pending") // pending | active | past_due | canceled
  totalBurnedCents     Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}